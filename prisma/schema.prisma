model RejectionEntry {
  RejectionEntryId BigInt    @id(map: "PK_RejectionEntry") @default(autoincrement())
  ProductId        Int
  PartNo           String    @db.NVarChar(255)
  ScrapDate        DateTime? @db.Date
  RejectedOn       DateTime? @db.Date
  FoundAt          String?   @db.NVarChar(255)
  LeakCode         String?   @db.NVarChar(255)
  Shift            String?   @db.NVarChar(100)
  ShopFloor        String?   @db.NVarChar(255)
  PartName         String?   @db.NVarChar(255)
  BhChThIm         String?   @db.NVarChar(255)
  OP               String?   @db.NVarChar(100)
  FixPos           String?   @db.NVarChar(255)
  DefectType       String?   @db.NVarChar(255)
  Dimension        String?   @db.NVarChar(100)
  Actual           Decimal?  @db.Decimal(18, 4)
  Qty              Decimal?  @db.Decimal(18, 3)
  OperatorName     String?   @db.NVarChar(255)
  LeaderName       String?   @db.NVarChar(255)
  Decision         String?   @db.NVarChar(255)
  RejectionReason  String?   @db.NVarChar(Max)
